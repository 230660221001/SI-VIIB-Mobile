TD
    MaterialApp --> Scaffold
    Scaffold --> AppBar["AppBar: 'Katalog Armada Mobil'"]
    Scaffold --> body["body: Padding"]
    Scaffold --> FAB["floatingActionButton: FloatingActionButton"]
    body --> Column
    Column --> Row["Row (Ikon + Judul Header)"]
    Column --> Expanded
    Expanded --> ListViewBuilder["ListView.builder"]
    ListViewBuilder --> Card
    Card --> ListTile["ListTile (Nama, Kategori, Status)"]